OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Lets OpenAI search the web only for questions that need current public information.
# It may add cost and a small delay. Keep false for an offline-style demo.
WEB_SEARCH_ENABLED=false
# Choose "openai" (current built-in web search) or "firecrawl" (source-grounded pages).
WEB_SEARCH_PROVIDER=openai
# Cache only answers where the web tool was actually used; values clear on app restart.
WEB_SEARCH_CACHE_SECONDS=900
# Needed only when WEB_SEARCH_PROVIDER=firecrawl. Keep this private in .env.
FIRECRAWL_API_KEY=
# Firecrawl source pages are cached in memory for this many seconds.
FIRECRAWL_CACHE_SECONDS=900

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_DEFAULT=
# Fast model for English, Arabic, Hindi, and other supported languages.
# Test another model for languages Flash does not officially list, such as Urdu or Dari.
ELEVENLABS_MODEL=eleven_flash_v2_5
TTS_OUTPUT_PATH=output/reply.mp3

# Optional per-language ElevenLabs voices
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_AR=
ELEVENLABS_VOICE_HI=
ELEVENLABS_VOICE_RU=
ELEVENLABS_VOICE_UR=
ELEVENLABS_VOICE_ES=
ELEVENLABS_VOICE_FR=
ELEVENLABS_VOICE_DE=
ELEVENLABS_VOICE_ZH=
ELEVENLABS_VOICE_FA=
ELEVENLABS_VOICE_PS=
ELEVENLABS_VOICE_TL=
ELEVENLABS_VOICE_SW=
ELEVENLABS_VOICE_AM=
ELEVENLABS_VOICE_SO=

RAG_ENABLED=false
RAG_DOCUMENTS_DIR=knowledge_base
RAG_PERSIST_DIRECTORY=chroma_db

# Multilingual Whisper model: tiny, base, small, or medium.
WHISPER_MODEL=small
WHISPER_LANGUAGE=

# "openai" uses cloud transcription and falls back to local Whisper on failure.
# Set to "local" to use faster-whisper only.
STT_PROVIDER=openai
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Live information defaults for questions about current time and weather.
EVENT_CITY=Dubai
EVENT_TIMEZONE=Asia/Dubai
WEATHER_CACHE_SECONDS=300
# Briefly cache lookup failures so an internet outage does not cause repeated timeouts.
WEATHER_FAILURE_CACHE_SECONDS=60

# Optional case-insensitive substrings from the startup device list.
# Leave blank to use the Linux system defaults.
INPUT_DEVICE_NAME=
OUTPUT_DEVICE_NAME=
